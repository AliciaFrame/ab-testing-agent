  {
    "type": "function",
    "function": {
      "name": "check_sample_ratio",
      "description": "Chi-square test of whether impressions match the intended equal split across arms.",
      "parameters": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string",
            "description": "The test identifier exactly as given; running tests look like <id>@25."
          }
        },
        "required": [
          "test_id"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "compare_arms",
      "description": "Two-sided pooled two-proportion z-test of click-through rate between two arms. Returns the uncorrected p-value.",
      "parameters": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string",
            "description": "The test identifier exactly as given; running tests look like <id>@25."
          },
          "arm_a": {
            "type": "string",
            "description": "Arm letter, for example A."
          },
          "arm_b": {
            "type": "string",
            "description": "Arm letter, for example A."
          }
        },
        "required": [
          "test_id",
          "arm_a",
          "arm_b"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "power_calc",
      "description": "Impressions needed per arm to detect a relative lift in click-through rate with a two-sided two-proportion test.",
      "parameters": {
        "type": "object",
        "properties": {
          "baseline_ctr": {
            "type": "number",
            "description": "Baseline click-through rate (0-1)."
          },
          "relative_lift": {
            "type": "number",
            "description": "Relative lift, 0.2 = 20%."
          },
          "alpha": {
            "type": "number",
            "description": "Two-sided significance level."
          },
          "power": {
            "type": "number",
            "description": "Statistical power, for example 0.8."
          }
        },
        "required": [
          "baseline_ctr",
          "relative_lift",
          "alpha",
          "power"
        ],
        "additionalProperties": false
      }
    }
  },
