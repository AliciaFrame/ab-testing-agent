  {
    "type": "function",
    "function": {
      "name": "submit_verdict",
      "description": "Record the final verdict for a single-test request. Call exactly once, at the end.",
      "parameters": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string",
            "description": "The test identifier exactly as given; running tests look like <id>@25."
          },
          "verdict": {
            "type": "string",
            "enum": [
              "VALID",
              "INVALID",
              "SHIP",
              "KEEP_TESTING",
              "NO_DIFFERENCE",
              "HEADLINE",
              "IMAGE",
              "BOTH",
              "NEITHER"
            ]
          },
          "winning_arm": {
            "type": [
              "string",
              "null"
            ],
            "description": "Arm to ship when the verdict is SHIP, otherwise null."
          },
          "srm_p_value": {
            "type": "number",
            "description": "p-value from check_sample_ratio."
          },
          "summary": {
            "type": "string",
            "description": "One or two sentences of rationale."
          }
        },
        "required": [
          "test_id",
          "verdict",
          "winning_arm",
          "srm_p_value",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_scorecard",
      "description": "Record the verdict counts for every test in a time window. Call exactly once, at the end.",
      "parameters": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "ISO datetime, for example 2014-03-04T09:00."
          },
          "end": {
            "type": "string",
            "description": "ISO datetime, for example 2014-03-04T09:00."
          },
          "counts": {
            "type": "object",
            "properties": {
              "SHIP": {
                "type": "integer"
              },
              "KEEP_TESTING": {
                "type": "integer"
              },
              "NO_DIFFERENCE": {
                "type": "integer"
              },
              "INVALID": {
                "type": "integer"
              }
            },
            "required": [
              "SHIP",
              "KEEP_TESTING",
              "NO_DIFFERENCE",
              "INVALID"
            ],
            "additionalProperties": false
          },
          "ship": {
            "type": "array",
            "description": "Every test with verdict SHIP and its winning arm.",
            "items": {
              "type": "object",
              "properties": {
                "test_id": {
                  "type": "string",
                  "description": "The test identifier exactly as given; running tests look like <id>@25."
                },
                "arm_id": {
                  "type": "string",
                  "description": "Arm letter, for example A."
                }
              },
              "required": [
                "test_id",
                "arm_id"
              ],
              "additionalProperties": false
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "counts",
          "ship",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
